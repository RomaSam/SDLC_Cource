{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .claude/hooks/check_secrets.py",
            "timeout": 10,
            "statusMessage": "Checking for secrets..."
          }
        ]
      },
      {
        "matcher": "Read|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .claude/hooks/block_env_read.py",
            "timeout": 10,
            "statusMessage": "Checking file access policy..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .claude/hooks/ruff_check.py",
            "timeout": 15,
            "statusMessage": "Running ruff check..."
          },
          {
            "type": "command",
            "command": "py -3 .claude/hooks/pytest_check.py",
            "timeout": 60,
            "statusMessage": "Running pytest..."
          }
        ]
      }
    ]
  }
}
